<?xml version="1.0" encoding="utf-8"?>
<!--
    The card-against-the-phone prompt, with two states in one layout: waiting for a card, and
    reading one. Reading an emv card takes a couple of seconds, and in silence that is
    indistinguishable from nothing happening .. which is what makes people move the card.

    The brand bar is the same dark, rounded, partly translucent graphic the 3ds sheet uses, and
    it wants the same treatment: the content below it pulled up underneath by a negative margin,
    so the bar's own rounded bottom fades into that content instead of sitting over a hard edge.
    Without the overlap the bar's soft edge showed directly against a flat white a few dp below
    it, which read as a smear rather than a header.

    The root itself carries no background, the same as the 3ds sheet's root. The bar's own
    CardView rounds all four of its corners, not just the top two, so a white fill on the root
    behind it showed through the gap between the bar's rounded corner and the root's square one
    .. a white wedge poking out on both sides, above the bar rather than below it. Left
    transparent, that gap shows the sheet's own dim scrim instead, which reads as the bar simply
    having rounded corners rather than as something leaking out from behind it. The content below
    the bar still gets its own white fill, on the inner wrapper, where it is actually needed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:orientation="vertical">

    <company.tap.tappaybutton.TapBrandView
        android:id="@+id/tab_brand_view_nfc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="locale" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-25dp"
        android:background="@android:color/white"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="33dp">

            <ImageView
                android:id="@+id/nfc_animation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/nfc_title"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/nfc_progress"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/nfc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/nfc_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nfc_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="36dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:minHeight="40dp"
            android:gravity="center"
            android:text="@string/nfc_description"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
